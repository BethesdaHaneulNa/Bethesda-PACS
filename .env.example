# Bethesda PACS settings. setup.ps1 / setup.sh write the real .env on the first run with
# random secrets - you do not need to copy this file. It only lists what .env can hold.
# Never commit .env.

# Orthanc admin password (user "admin"). Required: docker compose refuses to start without it.
# setup generates it; pair-with-emr gives it to the EMR so staff never need it.
ORTHANC_PASSWORD=

# Worklist bridge -> EMR. Must match the EMR's Settings -> Order Feed -> Bridge Token.
# setup generates it; pair-with-emr.ps1 / .sh sets the same value on both sides.
BRIDGE_TOKEN=

# Where the EMR's order feed is (default: the EMR on this machine).
# EMR_FEED_URL=http://host.docker.internal:9080/api/pacs/worklist-feed

# Folder of the images and their index (default ./storage). setup asks at the first
# installation; move-image-storage.ps1 moves an installed store and rewrites this line.
# ORTHANC_STORAGE_PATH=D:/Bethesda-PACS-images

# Called AE Title the imaging devices are set to (default MEDCONNECT), and the name
# Orthanc shows (default Bethesda PACS). Change the AE only together with every device.
# ORTHANC_AET=MEDCONNECT
# PACS_NAME=Bethesda PACS
